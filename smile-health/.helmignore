# Patterns to ignore when building Helm packages.
# This file is used by `helm package`.
# It supports glob patterns, relative paths, and negation.

# Common patterns
*.tgz
*.tar.gz
*.zip
*.tar.bz2
*.jar
*.war
*.ear
*.class
*.so
*.dylib
*.a
*.lib
*.pc
*.la
*.lo
*.o
*.obj
*.exe
*.dll
*.sys
*.suo
*.user
*.userosscache
*.sln.docstates

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.git/
.gitignore
.gitmodules

# Documentation
*.md
!README.md

# CI/CD
.gitlab-ci.yml
.github/
.gitlab/

# Dependencies
node_modules/
vendor/
package-lock.json
yarn.lock

# Environment files
.env*
!.env.example

# Logs
logs/
*.log

# Test files
coverage/
.nyc_output/
test/
tests/
__tests__/

# Build artifacts
dist/
build/
out/
target/
bin/

# Temporary files
tmp/
temp/
.tmp/

# Docker files
Dockerfile*
docker-compose*
.dockerignore
